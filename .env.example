# Contraseña para entrar a /admin (obligatoria en producción)
ADMIN_PASSWORD=

# Clave para firmar la sesión del admin. Cualquier texto largo y aleatorio.
# Si la dejas vacía se usa ADMIN_PASSWORD.
ADMIN_SECRET=

# Vercel la crea sola al conectar un Blob Store (Storage → Blob) al proyecto.
BLOB_READ_WRITE_TOKEN=
